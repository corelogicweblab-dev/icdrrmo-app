# Public Mapbox token (URL-restrict in Mapbox dashboard). Baked in at `next build` for Docker.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Relative = Next rewrites REST + Socket.IO to Nest (see `next.config.ts`).
NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_WS_URL=http://127.0.0.1:4000
# Leave unset so the browser uses the dashboard origin + rewrite (recommended for npm run dev).
#
# Static export (Firebase Hosting): `npm run export` / root `npm run deploy:hosting`.
# next.config requires absolute https? URLs for NEXT_PUBLIC_API_URL and NEXT_PUBLIC_WS_URL.
#
# Local deploy: copy `.env.deploy.example` → `.env.deploy` (gitignored). Export loads `.env.deploy`
# after the process env so dev `.env.local` (/api/v1) does not break production builds.

# Windy Map Forecast API — add allowed domains at https://api.windy.com/keys
# NEXT_PUBLIC_WINDY_API_KEY=
