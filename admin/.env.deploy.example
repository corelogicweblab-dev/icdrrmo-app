# Copy to `.env.deploy` (gitignored) and fill for `npm run export` / `npm run deploy:hosting`.
# These override dev `.env.local` so production API URLs are baked into the Firebase bundle.
#
# GitHub Actions must use the SAME values in repo secrets (Settings → Secrets → Actions).
# Wrong Render hostname (e.g. icdrrmo-app-1) → login "Failed to fetch". This API service is:
NEXT_PUBLIC_API_URL=https://icdrrmo-api.onrender.com/api/v1
NEXT_PUBLIC_WS_URL=https://icdrrmo-api.onrender.com
NEXT_PUBLIC_MAPBOX_TOKEN=
