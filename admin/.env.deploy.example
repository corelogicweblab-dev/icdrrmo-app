# Copy to `.env.deploy` (gitignored) and fill for `npm run export` / `npm run deploy:hosting`.
# These override dev `.env.local` so production API URLs are baked into the Firebase bundle.

NEXT_PUBLIC_API_URL=https://your-api-host.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://your-api-host.example.com
NEXT_PUBLIC_MAPBOX_TOKEN=
