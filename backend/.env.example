# ── Database ─────────────────────────────────────────────────────────
# Local Postgres (`docker compose up` publishes :5432). Use this for `prisma migrate` + the API:
DATABASE_URL="postgresql://icdrrmo:icdrrmo@localhost:5432/icdrrmo?schema=public"
#
# Render / cloud Postgres (example shape — use your host, user, password, DB name):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.render.com/icdrrmo?schema=public"
# Run ALL Prisma commands from `backend/` (or `npm run prisma:generate` / `npm run db:seed` from repo root).

# Prisma Accelerate (runtime): put `DATABASE_URL=prisma+postgres://…` ONLY when the app/runtime
# should hit Accelerate. Migrations REQUIRE a plain Postgres URL — run one-shot, e.g. PowerShell:
#   $env:DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/icdrrmo?schema=public'; npx prisma migrate deploy
# See `prisma/README.md`.

# JWT — use JWT_ACCESS_SECRET only (no refresh secret). Login/register return { accessToken }.
# Render: set JWT_ACCESS_SECRET in the web service environment; rotate if leaked.
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-48"
JWT_ACCESS_EXPIRES_SEC="900"

# Deploy: Render (Nest API) + Firebase Hosting (static admin). Set CORS_ORIGINS to your Hosting URL(s).

# SMS gateway → API webhook (HMAC input: `${from}|${body}`)
SMS_WEBHOOK_SECRET="shared-secret-with-sms-gateway"

# Redis (BullMQ — optional). On Render without Redis: delete this line or leave empty so queues stay off.
# If set to redis://127.0.0.1:6379 on a cloud host with no Redis, the API will get ECONNREFUSED at startup.
REDIS_URL="redis://localhost:6379"

# HTTP
PORT="4000"
# Comma-separated, no spaces. Include live Hosting + firebaseapp.com; add preview channels if you use them, e.g.
# https://icdrrmo-b204e--pr-12.web.app
CORS_ORIGINS="http://localhost:3000,http://localhost,https://icdrrmo-b204e.web.app,https://icdrrmo-b204e.firebaseapp.com"

# Optional seed overrides
# SEED_ADMIN_EMAIL="ops.admin@icdrrmo.local"
# SEED_ADMIN_PASSWORD="ChangeMe!OpsAdmin12"

# ── Firestore profile mirror (optional) ─────────────────────────────
# When set, Nest upserts `citizen_profiles/{userId}` on register + profile updates (Firebase Console).
# Prefer a single-line JSON service account (escape newlines in private_key as \n):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"…",...}'
# Or split fields (Render / shell — use \n for newlines inside the key):
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@....iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# Or: GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
#
# Mobile / web Firestore: after Nest login, call POST /auth/firebase-custom-token (Bearer JWT).
# Returns { customToken }; client uses Firebase SDK `signInWithCustomToken` — uid matches `users.id`.
# Firestore rules allow read on `citizen_profiles/{userId}` when `request.auth.uid == userId`.
