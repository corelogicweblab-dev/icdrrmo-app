# Root Compose — copy to `.env` in this folder
#
# Optional Compose override — use plain Postgres URLs for migrations + API (`backend/.env.example`).

JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-min-32-chars
SMS_WEBHOOK_SECRET=shared-secret-with-android-sms-relay

# Admin (browser) — defaults in docker-compose target API on host port 4000 so http://localhost:3000 works without nginx.
# If you only open http://localhost (nginx on :80), you may set:
# NEXT_PUBLIC_API_URL=http://localhost/api/v1
# NEXT_PUBLIC_WS_URL=http://localhost

# Mapbox (passed as Docker build-arg for `admin` — set before `docker compose build admin`)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Hosting / Firebase / GCP — save the downloaded service account JSON locally as
# `infra/hosting/service-account.json` (that path is gitignored). Then point SDKs and CLIs at it:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/repo/infra/hosting/service-account.json
# In CI, write the JSON from your provider’s secret store to a temp file and set the same variable — never commit keys.
# Optional override for `npm run firebase:seed` (defaults to icdrrmo-b204e).
# FIREBASE_PROJECT_ID=icdrrmo-b204e
#
# GitHub Actions (Firebase Hosting deploy):
# - FIREBASE_SERVICE_ACCOUNT_ICDRRMO_B204E — minified one-line JSON for a CI service account with at least
#   Firebase Hosting Admin (and Firebase Rules Admin if you deploy Firestore rules from CI).
# - NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WS_URL — production REST + Socket.IO origins (required for static export).
# - NEXT_PUBLIC_MAPBOX_TOKEN — optional; map tiles need this at build time if you use the situation map.
#
# After `firebase login`, deploy the admin static site: `npm run deploy:hosting` from repo root.
#
# Docker Compose API — allow the Firebase-hosted admin to call Nest (override default list if needed):
# CORS_ORIGINS=http://localhost,http://localhost:3000,https://icdrrmo-b204e.web.app,https://icdrrmo-b204e.firebaseapp.com
