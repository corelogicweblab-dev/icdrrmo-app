rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client-readable app gates (no secrets). Written only via Admin SDK / Console.
    match /config_public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Static reference lists for clients (e.g. emergency type labels).
    match /reference/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public advisories (weather, drills). Treat content as non-sensitive.
    match /broadcasts/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user subtree — requires Firebase Auth uid to match path segment.
    // Link backend `users.id` to Firebase Auth uid (same value or mapped) before relying on this.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile mirror: doc id = Nest `users.id`. Admin SDK writes; clients read after `signInWithCustomToken(uid)`.
    // Custom tokens are minted by Nest (`POST /auth/firebase-custom-token`) with uid == userId.
    match /citizen_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Keep writes on Nest/Postgres so data stays consistent; Admin SDK bypasses these rules.
      allow write: if false;
    }
  }
}
